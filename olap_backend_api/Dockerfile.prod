FROM python:3.13-slim AS deps

WORKDIR /app

COPY ./requirements/base.txt /app/
RUN pip install --upgrade pip && pip install --no-cache-dir -r base.txt

FROM python:3.13-slim AS runner

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings.production

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-client \
        curl \
        supervisor \
        && rm -rf /var/lib/apt/lists/*

COPY --from=deps /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

COPY . .

RUN groupadd -r django && useradd -r -g django django \
    && chown -R django:django /app

RUN python manage.py collectstatic --noinput

# Shared volumes /app/staticfiles and /app/media are initialized with the
# ownership of the image mountpoint on first use, so make them django-writable
# (the build-time collectstatic above ran as root).
RUN chown -R django:django /app/staticfiles \
    && mkdir -p /app/media \
    && chown -R django:django /app/media

COPY entrypoint.prod.sh /app/entrypoint.prod.sh
RUN chmod +x /app/entrypoint.prod.sh

USER django

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.prod.sh"]

CMD ["supervisord", "-c", "/app/supervisord.prod.conf"]
