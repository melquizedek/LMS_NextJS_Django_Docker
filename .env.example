# ============================================================
# LMS stack environment variables
# Copy to .env on the server and fill in real values.
# NEVER commit the real .env (it is gitignored).
#
# Deploy (see docker-compose.prod.yml):
#   docker compose -f docker-compose.prod.yml up --build -d
# ============================================================

# ── Django settings module ────────────────────────────────────
# Production: config.settings.production (DEBUG=False)
# Development: config.settings.development
DJANGO_SETTINGS_MODULE=config.settings.production

# ── Django (required) ────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Comma-separated. Include the VM IP/domain + the internal service names.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,olap_backend_api,company_website,olap_web_app,yourdomain.com
# Comma-separated browser origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ── Database (olap_db) ────────────────────────────────────────
# NOTE: the app reads these POSTGRES_* vars directly (NOT DATABASE_URL).
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change-me
# "olap_db" is the compose service name on the app_network.
POSTGRES_HOST=olap_db
POSTGRES_PORT=5432

# ── Redis + Celery (olap_redis) ──────────────────────────────
REDIS_HOST=olap_redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
CELERY_BROKER_URL=redis://:change-me@olap_redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@olap_redis:6379/0

# ── Next.js frontends (build-time) ───────────────────────────
# Used to build company_website and olap_web_app images.
NEXT_PUBLIC_API_HOST=https://api.yourdomain.com

# ── Optional: Email ──────────────────────────────────────────
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ── Optional: SMS (Infobip) ──────────────────────────────────
INFOBIP_API_KEY=
INFOBIP_API_BASE_URL=
INFOBIP_SENDER_ID=

# ── Optional: SMS (Twilio) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Optional: Other ──────────────────────────────────────────
SENTRY_DSN=
