# ============================================================
# ENVIRONMENT VARIABLES — never commit secrets
# ============================================================
.env
.env.*
!.env.example        # Allow the template file to be committed

# ============================================================
# DOCKER
# ============================================================
# Override files with sensitive configs
docker-compose.override.yml
README.Docker.md

# ============================================================
# OS & EDITOR ARTIFACTS
# ============================================================

# macOS
**/.DS_Store
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# VSCode
.vscode/
!.vscode/extensions.json   # Allow sharing recommended extensions

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# ============================================================
# LOGS
# ============================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# DJANGO MEDIA (user uploads — served at runtime)
# ============================================================
backend/media/

# ============================================================
# NEXT.JS - FRONTEND
# ============================================================
.next/              # Build output
out/                # Static export output
build/

# Standalone output (generated by output: 'standalone')
.next/standalone/
.next/static/

# Cache
.next/cache/

# ============================================================
# NODE
# ============================================================
node_modules/
.npm/
.yarn/

# Package manager locks (keep only the one you use)
# If using npm  → keep package-lock.json, ignore yarn.lock
# If using yarn → keep yarn.lock, ignore package-lock.json
yarn.lock           # Remove this line if you use Yarn
# package-lock.json # Uncomment if you use Yarn

# ============================================================
# TESTING
# ============================================================
coverage/
.nyc_output/

# ============================================================
# TYPESCRIPT
# ============================================================
*.tsbuildinfo
next-env.d.ts       # Auto-generated by Next.js — do not edit manually

# ============================================================
# MISC
# ============================================================
.turbo/             # Turborepo cache (if used)
*.pem               # SSL certificates


# ============================================================
# Graphify
# ============================================================
graphify-out/cache