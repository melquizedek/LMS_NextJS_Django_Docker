# ============================================================
# NEXT.JS
# ============================================================
.next/              # Build output
out/                # Static export output
build/

# Standalone output (generated by output: 'standalone')
.next/standalone/
.next/static/

# Cache
.next/cache/

# ============================================================
# NODE
# ============================================================
node_modules/
.npm/
.yarn/

# Package manager locks (keep only the one you use)
# If using npm  → keep package-lock.json, ignore yarn.lock
# If using yarn → keep yarn.lock, ignore package-lock.json
yarn.lock           # Remove this line if you use Yarn
# package-lock.json # Uncomment if you use Yarn

# ============================================================
# TESTING
# ============================================================
coverage/
.nyc_output/

# ============================================================
# TYPESCRIPT
# ============================================================
*.tsbuildinfo
next-env.d.ts       # Auto-generated by Next.js — do not edit manually

# ============================================================
# MISC
# ============================================================
.turbo/             # Turborepo cache (if used)
*.pem               # SSL certificates